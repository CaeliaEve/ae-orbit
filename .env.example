# Run: python scripts/init_env.py
# The generated .env is local and must not be committed.
POSTGRES_PASSWORD=
AE_ADMIN_TOKEN=

# Local Compose origin. For external OC access use the HTTPS override and AE_DOMAIN.
AE_HTTP_PORT=8080
AE_PUBLIC_URL=http://127.0.0.1:8080
AE_DOMAIN=

# For a native process set AE_DATABASE_URL and AE_LISTEN in its environment.
# The Go process does not automatically read this .env file.
# AE_DATABASE_URL=postgres://aeorbit:password@127.0.0.1:5432/aeorbit?sslmode=disable
# AE_LISTEN=127.0.0.1:8080

GOMEMLIMIT=256MiB
AE_CONTAINER_MEMORY=512m
AE_DB_CONNECTIONS=16
AE_BATCH_BYTES=32768
AE_BATCH_ITEMS=128
AE_RESPONSE_BYTES=32768
AE_GROUP_PLANNING=1
AE_SCAN_ITEMS=32
AE_ACTIVE_WINDOW=4
AE_MAX_QUEUED=256
AE_MAX_CONCURRENT=64
AE_MAX_STREAMS=32
AE_OFFLINE_SECONDS=90
AE_RECHECK_SECONDS=300
AE_POLL_MILLIS=1000
